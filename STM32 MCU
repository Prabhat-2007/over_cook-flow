const int BUZZER_PIN = 8;
const int RELAY_PIN = 7; 

void setup() {
  // Serial communication over the internal Linux-to-MCU inter-processor bridge
  Serial.begin(115200); 
  
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, HIGH); // Relay normally ON
}

void loop() {
  if (Serial.available() > 0) {
    char alertType = Serial.read();

    switch(alertType) {
      case 'O': // OVERFLOW ALARM
        tone(BUZZER_PIN, 2000); // High pitch continuous tone
        digitalWrite(RELAY_PIN, LOW); // Cut stove relay power
        break;

      case 'C': // OVERCOOK ALARM
        // Pulsing warning sound
        tone(BUZZER_PIN, 1000);
        delay(200);
        noTone(BUZZER_PIN);
        delay(200);
        break;

      case 'S': // SAFE STATE
      default:
        noTone(BUZZER_PIN);
        digitalWrite(RELAY_PIN, HIGH);
        break;
    }
  }
}
